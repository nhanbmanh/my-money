// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  username      String    @unique
  bod           DateTime?
  gender        String?
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  otpCodes            OtpCode[]
  sources             Source[]
  categories          Category[]
  secondaryCategories SecondaryCategory[]
  cashFlows           CashFlow[]

  // Wealth Management Relations
  holdings           Holding[]
  wealthTransactions WealthTransaction[]
  liabilities        Liability[]

  @@map("users")
}

model OtpCode {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("otp_codes")
}

model Source {
  id         String     @id @default(uuid())
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceName String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  cashFlows  CashFlow[]

  @@map("sources")
}

model Category {
  id           String     @id @default(uuid())
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryName String
  budgetLimit  Float?     @default(-1)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  cashFlows    CashFlow[]

  @@map("categories")
}

model SecondaryCategory {
  id           String     @id @default(uuid())
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryName String
  type         Int        @default(0)
  budgetLimit  Float?     @default(-1)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  cashFlowSecondaryCategories CashFlowSecondaryCategory[]

  @@map("secondary_categories")
}

model CashFlow {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId          String?
  source            Source?   @relation(fields: [sourceId], references: [id])
  primaryCategoryId String?
  primaryCategory   Category? @relation(fields: [primaryCategoryId], references: [id])
  title             String
  datetime          DateTime  @default(now())
  cashType          CashType  @default(Expense)
  amountOfMoney     Float
  description       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  secondaryCategories CashFlowSecondaryCategory[]

  @@index([userId, datetime])
  @@index([userId, primaryCategoryId])
  @@index([userId, sourceId])
  @@map("cash_flows")
}

model CashFlowSecondaryCategory {
  id                  String            @id @default(uuid())
  cashFlowId          String
  cashFlow            CashFlow          @relation(fields: [cashFlowId], references: [id], onDelete: Cascade)
  secondaryCategoryId String
  secondaryCategory   SecondaryCategory @relation(fields: [secondaryCategoryId], references: [id])

  @@unique([cashFlowId, secondaryCategoryId])
  @@map("cash_flow_secondary_categories")
}

enum CashType {
  Income
  Expense
}

// --------------------------------------------------------
// WEALTH MANAGEMENT SYSTEM MODELS (QUẢN LÝ GIA SẢN)
// --------------------------------------------------------

model MacroCategory {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  holdings           Holding[]
  wealthTransactions WealthTransaction[]

  @@map("macro_categories")
}

model Asset {
  id             String   @id @default(uuid())
  symbolOrTicker String
  assetName      String
  isMarketDriven Boolean  @default(true)
  assetClass     String   @default("STOCKS") // STOCKS, CRYPTO, GOLD, BOND, REAL_ESTATE, VEHICLE, LOAN, CASH
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  holdings           Holding[]
  wealthTransactions WealthTransaction[]

  @@index([symbolOrTicker])
  @@map("assets")
}

model Holding {
  id                 String         @id @default(uuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryType       Int            @default(0) // 0: Liquid, 1: Growth, 2: Physical, 3: Debt/Mortgage, 4: Lending
  macroCategoryId    String?
  macroCategory      MacroCategory? @relation(fields: [macroCategoryId], references: [id], onDelete: SetNull)
  assetId            String
  asset              Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  quantity           Float          @default(0)
  averageCostBasis   Float          @default(0)
  currentValue       Float          @default(0)
  investableFlag     Boolean        @default(true)
  linkedLiabilityId  String?        @unique
  linkedLiability    Liability?     @relation("HoldingLiabilityLink", fields: [linkedLiabilityId], references: [id])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  liabilitiesAttached Liability[] @relation("AttachedHolding")

  @@index([userId])
  @@index([macroCategoryId])
  @@index([assetId])
  @@map("holdings")
}

model WealthTransaction {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime       @default(now())
  transactionType String         // BUY, SELL, DEPOSIT, WITHDRAW, DIVIDEND, EXPENSE, REVALUATION, TRANSFER
  macroCategoryId String?
  macroCategory   MacroCategory? @relation(fields: [macroCategoryId], references: [id], onDelete: SetNull)
  assetId         String?
  asset           Asset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)
  quantity        Float?         @default(0)
  price           Float?         @default(0)
  costBasis       Float?         @default(0)
  fee             Float?         @default(0)
  currency        String         @default("VND")
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId, date])
  @@index([macroCategoryId])
  @@map("wealth_transactions")
}

model Liability {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  totalDebt        Float     @default(0)
  interestRate     Float     @default(0)
  dueDate          DateTime?
  linkedHoldingId  String?
  linkedHolding    Holding?  @relation("AttachedHolding", fields: [linkedHoldingId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  holdingReference Holding?  @relation("HoldingLiabilityLink")

  @@index([userId])
  @@map("liabilities")
}